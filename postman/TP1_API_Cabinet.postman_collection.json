{
  "info": {
    "name": "TP1 - API Cabinet médical (patients, consultations, mesures)",
    "description": "Collection du TP1. Lancer le serveur (npm run dev) puis exécuter la collection avec le Runner Postman, dans l'ordre. Variable baseUrl : http://localhost:5000 (PC), http://10.0.2.2:5000 (émulateur Android) ou http://<IP du PC>:5000 (téléphone).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 - Patients",
      "item": [
        {
          "name": "POST patient valide (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/patients",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "patients"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Ben Salah\",\n  \"prenom\": \"Ali\",\n  \"age\": 34,\n  \"telephone\": \"22123456\",\n  \"medecin\": \"Dr Helmi\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set(\"patientId\", pm.response.json().id);",
                  "pm.test(\"id, statut Actif, createdAt présents\", function () { const j = pm.response.json(); pm.expect(j.id).to.be.a(\"string\"); pm.expect(j.statut).to.eql(\"Actif\"); pm.expect(j.createdAt).to.exist; pm.expect(j._id).to.be.undefined; });"
                ]
              }
            }
          ]
        },
